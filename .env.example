# Ambiente e Porta
NODE_ENV=development
PORT=3000

# Credenciais do Banco de Dados PostgreSQL / PostGIS (usado pelo Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="monitoramento_pragas"

# String de Conexão com o PostgreSQL / PostGIS
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# Segurança e Autenticação JWT
# ATENÇÃO: Em produção, gere uma chave criptograficamente segura com: openssl rand -base64 32
JWT_SECRET="super-secret-jwt-key-pest-monitoring-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_DAYS="30"

# CORS
CORS_ORIGIN="*"

# Rate Limiting (Segurança contra DoS e Brute-force)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
