# ==============================================================================
# AMBIENTE E PORTA DO SERVIDOR
# ==============================================================================
NODE_ENV=development
PORT=3000

# ==============================================================================
# BANCO DE DADOS POSTGRESQL / POSTGIS (DOCKER & LOCAL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=monitoramento_pragas

# String de conexão usada pelo Prisma ORM (para execução local fora do Docker):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/monitoramento_pragas?schema=public"

# ==============================================================================
# SEGURANÇA E AUTENTICAÇÃO JWT
# ==============================================================================
# ATENÇÃO: Em produção, gere uma chave criptograficamente segura com: openssl rand -base64 32
JWT_SECRET="super-secret-jwt-key-pest-monitoring-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_DAYS="30"

# ==============================================================================
# CORS E CONTROLE DE ACESSO
# ==============================================================================
CORS_ORIGIN="*"

# ==============================================================================
# RATE LIMITING (SEGURANÇA CONTRA DOS E BRUTE-FORCE)
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
